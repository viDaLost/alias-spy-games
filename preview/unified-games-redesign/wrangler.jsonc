{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alias-spy-games-unified-redesign-review",
  "main": "worker.js",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
