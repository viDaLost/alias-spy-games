# Скопируйте этот файл в .env и заполните локально. Файл .env не попадает в git.

# Токен от @BotFather. Вводите только здесь, не публикуйте в переписке.
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой — команда /id в боте).
# Пусто = админ-панель недоступна никому.
ADMIN_IDS=

# Необязательно: ID группы/чата для уведомлений вместо личных чатов администраторов.
ADMIN_CHAT_ID=

# Часовой пояс заведения.
TIMEZONE=Europe/Moscow

# true — засеять фиктивные занятые интервалы и показать кнопку их обновления админу.
DEMO_MODE=true

# Путь к базе SQLite (относительно папки проекта или абсолютный).
DATABASE_PATH=data/bot.db

# Необязательно: другой файл с данными клуба и меню.
CLUB_CONFIG=config/club.json

LOG_LEVEL=INFO
