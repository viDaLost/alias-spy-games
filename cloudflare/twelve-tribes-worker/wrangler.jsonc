// Комнаты «Двенадцати колен».
//
// Воркер держит только комнаты: сама игра лежит в приложении и приходит
// игроку оттуда же, откуда все остальные игры. Поэтому здесь нет раздачи
// файлов — только маршруты комнаты и Durable Object на каждую из них.
//
// Правила партии сюда не переписаны: src/rules.js импортирует те же файлы,
// что отдаются браузеру. Расходиться этим двум сторонам нельзя ни на строчку.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alias-spy-games-twelve-tribes",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://vidalost.github.io",
    "ALLOW_GUESTS": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "TwelveTribesRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TwelveTribesRoom"]
    }
  ]
}
