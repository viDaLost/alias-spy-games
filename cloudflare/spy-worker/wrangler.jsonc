{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alias-spy-games-spy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "SpyRoom"
      }
    ]
  },
  "exports": {
    "SpyRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://vidalost.github.io,https://appassets.androidplatform.net,https://alias-spy-games-app.vitaledanilov.workers.dev",
    "ALLOW_GUESTS": "true"
  }
}
