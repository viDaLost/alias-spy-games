{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alias-spy-games-bible-sketch",
  "main": "src/index-drawing-cycles.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "BibleSketchRoom"
      }
    ]
  },
  "exports": {
    "BibleSketchRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://vidalost.github.io",
    "ALLOW_GUESTS": "true"
  }
}
