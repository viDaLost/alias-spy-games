// Превью первой целостной рабочей версии приложения.
//
// Коммит b0d4e3e от 20 мая 2025: пять игр, все открываются, данные лежат
// рядом и целы, сеть не нужна вовсе. Всё, что до него, либо не подключало
// скрипты игр, либо тянуло слова из ветки main по сети, либо везло с
// повреждённым файлом данных — подробности в README рядом.
//
// Файлы в public/ — точная копия того коммита, без единой правки. Смысл
// превью в том, чтобы посмотреть, каким приложение было тогда; исправленная
// копия показывала бы что-то другое.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alias-spy-games-v1",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
