{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "alias-spy-games-bible-azbuka",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "AzbukaRoom"
      }
    ]
  },
  "preview_urls": false,
  "exports": {
    "AzbukaRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
