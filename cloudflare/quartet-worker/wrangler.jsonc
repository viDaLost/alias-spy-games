{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alias-spy-games-quartet",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "QuartetRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuartetRoom"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://vidalost.github.io",
    "ALLOW_GUESTS": "true"
  }
}
