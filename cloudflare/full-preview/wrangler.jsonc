{
  "name": "alias-spy-games-full-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../preview-dist/full",
    "binding": "PREVIEW_ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "QuartetRoom" },
      { "name": "SKETCH_ROOMS", "class_name": "BibleSketchRoom" },
      { "name": "SPY_ROOMS", "class_name": "SpyRoom" },
      { "name": "TRIBES_ROOMS", "class_name": "TwelveTribesRoom" },
      { "name": "LAND_ROOMS", "class_name": "PromisedLandRoom" }
    ]
  },
  "migrations": [{
    "tag": "v1",
    "new_sqlite_classes": ["QuartetRoom", "BibleSketchRoom", "SpyRoom", "TwelveTribesRoom", "KingdomsRoom", "PromisedLandRoom"]
  }],
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.1 } }
}
