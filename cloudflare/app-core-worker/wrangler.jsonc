// Core v15 support routing wrapped around src/index-v14.js RBAC: delegated admins receive and can answer support tickets.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alias-spy-games-core",
  "main": "src/index-v15.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USERS",
        "class_name": "UserStore"
      }
    ]
  },
  "exports": {
    "UserStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://vidalost.github.io,https://appassets.androidplatform.net",
    "ADMIN_TELEGRAM_ID": "1288379477",
    "ADMIN_AUTH_CODE_COPY_ENABLED": "true"
  }
}
