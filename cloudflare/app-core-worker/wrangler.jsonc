{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alias-spy-games-core",
  "main": "src/index-v2.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "USERS",
        "class_name": "UserStore"
      }
    ]
  },
  "exports": {
    "UserStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://vidalost.github.io",
    "ADMIN_TELEGRAM_ID": "1288379477",
    "LEGACY_GAS_URL": "https://script.google.com/macros/s/AKfycbx0o9HmRIF6vNuBUB2N4H3YuabJzYbRmAxvHCCwqnbMPn29Crv5W3FT1XGDF6VyFSn9/exec"
  }
}
