# Dependencies and generated output
node_modules/
dist/
coverage/

# web/dist is the opposite: GitHub Pages serves main:/ verbatim, so the built
# bundle has to be committed for the site to work at all.
!web/dist/
!web/dist/**

preview-dist/
*.log

# Local environment and Cloudflare state
.env
.env.*
!.env.example
.dev.vars
.wrangler/

# Editor and operating-system files
.DS_Store
.idea/
.vscode/
*.iml

# Temporary transfer artifacts
.upload/

# Android local/generated files and signing material
android-app/.gradle/
android-app/**/build/
android-app/local.properties
*.jks
*.keystore
*.apk
*.aab

# Копия картинок «Земли обетованной» для превью: собирается
# scripts/sync-promised-land-art.mjs из web/assets/promised-land.
# В репозитории эти файлы уже есть — второй раз они тут не нужны.
cloudflare/promised-land-preview/public/art/

# Промо-ролик: промежуточная сборка (кадры, wav, черновые mp4)
promo/ui-motion/build/
promo/ad/build/
promo/ad-28/build/
